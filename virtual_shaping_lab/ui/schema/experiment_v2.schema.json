{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExperimentV2",
  "type": "object",
  "required": ["program", "agent", "runtime"],
  "properties": {
    "program": {
      "type": "object",
      "required": ["phases"],
      "properties": {
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["protocol", "params", "trials"],
            "properties": {
              "name": { "type": "string" },
              "protocol": { "type": "string", "minLength": 1 },
              "stimuli": { "type": ["object", "null"] },
              "params": { "type": "object" },
              "trials": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": ["representation", "learning"],
      "properties": {
        "name": { "type": ["string", "null"] },
        "representation": { "type": "object" },
        "learning": { "type": "object" },
        "policy": { "type": ["object", "string", "null"] }
      },
      "additionalProperties": true
    },
    "runtime": { "type": "object" }
  },
  "additionalProperties": true
}
