{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-shaping-lab/protocols/extinction.schema.json",
  "title": "Extinction Protocol",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "protocol": { "const": "extinction" },
    "stimuli": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cs_plus": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "required": ["cs_plus"]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_trials": { "type": "integer", "minimum": 1 },
        "n_acquisition_trials": { "type": "integer", "minimum": 1 },
        "n_extinction_trials": { "type": "integer", "minimum": 1 },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "gamma": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["alpha"],
      "anyOf": [
        { "required": ["n_trials"] },
        { "required": ["n_acquisition_trials", "n_extinction_trials"] }
      ]
    }
  },
  "required": ["name", "protocol", "stimuli", "params"]
}
