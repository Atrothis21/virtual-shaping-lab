{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-shaping-lab/phases/criterion_shift.schema.json",
  "title": "Criterion Shift Phase",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "protocol": { "const": "criterion_shift" },
    "stimuli": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cs_plus": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "cs_minus": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["cs_plus"]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {}
    }
  },
  "required": ["name", "protocol", "stimuli", "params"]
}
