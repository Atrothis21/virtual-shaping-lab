{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virtual-shaping-lab/phases/compound_acquisition.schema.json",
  "title": "Compound Acquisition Phase",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "protocol": { "const": "compound_acquisition" },
    "stimuli": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compound": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": ["compound"]
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "n_trials": { "type": "integer", "minimum": 1, "default": 100 },
        "alpha_cs1": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
        "alpha_cs2": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.12 },
        "gamma": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.0 }
      },
      "required": ["n_trials", "alpha_cs1", "alpha_cs2"]
    }
  },
  "required": ["name", "protocol", "stimuli", "params"]
}
